<h1>Books</h1>

<% @books.each do |book| %>

  <p>Title</p>
  <span><%= book.title %></span>

  <p>Body</p>
  <span><%= book.body %></span> <span><%= link_to "Show", book_path(book.id) %></span>
  <span><%= link_to "Destroy", book_path(book), data: { turbo_method: :delete, turbo_confirm: "Are you sure ?" } %></span>
  
<% end %>

<h2>New book</h2>
<%= form_with model: @book, url: '/books', method: :post do |f| %>
  <h4>title</h4>
  <%= f.text_field :title %>
	
  <h4>body</h4>
  <%= f.text_area :body %>
	
  <%= f.submit 'Create Book' %>
<% end %>